{
  "hosting": {
    "public": ".next-build",
    "site": "niaerp",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      { "source": "/insights", "destination": "/resources/", "type": 301 },
      { "source": "/insights/:slug", "destination": "/resources/:slug/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/resources/**", "destination": "/resource_slug/index.html" },
      { "source": "/community/**", "destination": "/community_slug/index.html" },
      { "source": "/join/**", "destination": "/join/link/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|woff|ttf)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
        ]
      }
    ]
  },
  "firestore": {
    "database": "niaerpstorge",
    "indexes": "firestore.indexes.json"
  }
}