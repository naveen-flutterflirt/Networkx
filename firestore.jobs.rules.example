rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public enriched job opportunities.
    match /job_listings_enriched/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Public filter metadata used by the opportunity board.
    match /job_filters_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Public aggregate career-market snapshots generated by the worker.
    match /career_market_stats/{careerId} {
      allow read: if true;
      allow write: if false;
    }


    // Public run metadata used only for the latest market snapshot on Home/Market.
    match /market_intelligence_runs/{runId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else stays private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
